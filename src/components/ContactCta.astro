---
import { Image } from 'astro:assets';
import workbench from '../assets/photos/workbench-tools.jpg';
import { business } from '../data/site';
import { url } from '../lib/url';
---

<section class="cta" aria-labelledby="cta-title">
  <Image
    class="cta__image"
    src={workbench}
    alt=""
    widths={[768, 1280, 1920, 2400]}
    sizes="100vw"
  />
  <div class="cta__shade"></div>
  <div class="container cta__inner">
    <p class="label">Start a project</p>
    <h2 id="cta-title" class="display h-lg">Got a job<br />in mind?</h2>
    <p class="cta__text">
      Send a few details and some photos of the space. You’ll get a reply within two working days and, if it suits,
      a visit to measure up.
    </p>
    <div class="cta__actions">
      <a class="button button--light" href={url('contact/')}>Get a quote <span aria-hidden="true">→</span></a>
      <a class="button cta__phone" href={business.phoneHref}>Call {business.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    color: var(--on-dark);
    overflow: hidden;
  }

  .cta__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(20 16 12 / 0.82) 0%, rgb(20 16 12 / 0.55) 55%, rgb(20 16 12 / 0.25) 100%);
  }

  .cta__inner {
    display: grid;
    gap: 24px;
    padding-block: clamp(96px, 14vw, 200px);
  }

  .cta__text {
    max-width: 42ch;
    font-size: 1.125rem;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .cta__phone:hover {
    background: var(--paper);
    color: var(--ink);
  }
</style>
