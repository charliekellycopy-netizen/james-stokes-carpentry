---
import { business, nav } from '../data/site';
import { url } from '../lib/url';

interface Props {
  /** Light text over a full-bleed photo (home page hero). */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const current = Astro.url.pathname;
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <div class="container site-header__bar">
    <a class="brand" href={url()} aria-label={`${business.name} ${business.trade}, home`}>
      <span class="brand__name">James Stoke</span>
      <span class="brand__trade label">Carpentry &amp; Joinery</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => {
            const href = url(item.href);
            return (
              <li>
                <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <a class="site-header__phone label" href={business.phoneHref}>{business.phone}</a>

    <button class="menu-toggle label" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="menu-toggle__open">Menu</span>
      <span class="menu-toggle__close">Close</span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="container" aria-label="Mobile">
      <ul role="list">
        <li><a href={url()}>Home</a></li>
        {nav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
      </ul>
      <div class="mobile-menu__contact label">
        <a href={business.phoneHref}>{business.phone}</a>
        <a href={`mailto:${business.email}`}>{business.email}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const header = document.querySelector('.site-header');

  if (toggle && menu && header) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      header.classList.toggle('is-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => setOpen(menu.hidden));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 900px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    color: var(--ink);
  }

  .site-header--overlay {
    color: var(--on-dark);
  }

  .site-header.is-open {
    position: fixed;
    color: var(--on-dark);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: 32px;
    min-height: 88px;
    border-bottom: 1px solid var(--line);
    position: relative;
    z-index: 2;
  }

  .site-header--overlay .site-header__bar,
  .site-header.is-open .site-header__bar {
    border-color: var(--line-dark);
  }

  .brand {
    display: grid;
    gap: 2px;
    margin-right: auto;
    text-decoration: none;
  }

  .brand__name {
    font-weight: 800;
    font-stretch: 118%;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    line-height: 1;
  }

  .brand__trade {
    font-size: 0.6875rem;
    opacity: 0.75;
  }

  .site-nav {
    display: none;
  }

  .site-nav ul {
    display: flex;
    gap: 36px;
  }

  .site-nav a {
    position: relative;
    padding-block: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-header__phone {
    display: none;
    text-decoration: none;
  }

  .menu-toggle {
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid currentColor;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .menu-toggle__close,
  .site-header.is-open .menu-toggle__open {
    display: none;
  }

  .site-header.is-open .menu-toggle__close {
    display: inline;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    padding-top: 120px;
    background: var(--walnut);
    color: var(--on-dark);
    overflow-y: auto;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu ul {
    display: grid;
    border-top: 1px solid var(--line-dark);
  }

  .mobile-menu li a {
    display: block;
    padding-block: 16px;
    border-bottom: 1px solid var(--line-dark);
    font-size: 2rem;
    font-weight: 800;
    font-stretch: 118%;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1.1;
  }

  .mobile-menu__contact {
    display: grid;
    gap: 12px;
    margin-top: 40px;
    color: var(--on-dark-soft);
  }

  .mobile-menu__contact a {
    text-decoration: none;
    text-transform: none;
  }

  @media (min-width: 900px) {
    .site-nav {
      display: block;
    }

    .menu-toggle {
      display: none;
    }
  }

  @media (min-width: 1100px) {
    .site-header__phone {
      display: inline;
    }
  }
</style>
