---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactCta from '../components/ContactCta.astro';
import { boroughs } from '../data/site';
import portrait from '../assets/photos/carpenter-at-work.jpg';
import chiselDetail from '../assets/photos/chisel-detail.jpg';

const values = [
  {
    title: 'Fixed, written quotes',
    text: 'You get a price in writing before work starts. If something changes, you hear about it before it costs you anything.',
  },
  {
    title: 'One person, start to finish',
    text: 'The person who measures up is the person who builds and fits. No hand-offs, no subcontractors you haven’t met.',
  },
  {
    title: 'Tidy sites',
    text: 'Dust sheets down, tools away at the end of each day, and the room left clean when the job is done.',
  },
  {
    title: 'Made to last',
    text: 'Proper joints, the right timber for the job and finishes that can be repaired rather than replaced.',
  },
];
---

<Base
  title="About"
  description="About James Stokes, a London carpenter and joiner, how James works, and the London boroughs covered."
>
  <section class="page-head">
    <div class="container page-head__grid">
      <div>
        <p class="label muted">About</p>
        <h1 class="display h-lg">About<br />James</h1>
      </div>
      <p class="page-head__intro lede">A carpenter and joiner working in homes across London.</p>
    </div>
  </section>

  <section class="container bio" aria-labelledby="bio-title">
    <Image
      class="bio__image"
      src={portrait}
      alt="Placeholder photo: a carpenter working at a bench"
      widths={[480, 800, 1200]}
      sizes="(min-width: 900px) 45vw, 100vw"
    />
    {/* PLACEHOLDER BIOGRAPHY: replace the bracketed text with James's real background. */}
    <div class="bio__text">
      <p class="label placeholder-tag">Placeholder text</p>
      <h2 id="bio-title" class="bio__title">Background</h2>
      <p>
        James has worked as a carpenter in London since [year]. James trained at [college or apprenticeship] and spent
        [number] years with [previous firm] working on [type of work] before going independent in [year].
      </p>
      <p>
        [A sentence or two about the work James enjoys most, for example period staircases or built-in storage, and why.]
      </p>
      <p>
        [Qualifications, memberships and insurance, for example City &amp; Guilds, a trade association and public
        liability cover. Only list what is true and can be checked.]
      </p>
      <p>
        [Where the workshop is, and anything else a client should know, such as who else helps on larger jobs.]
      </p>
    </div>
  </section>

  <section class="section section--stone values" aria-labelledby="values-title">
    <div class="container">
      <div class="section-head">
        <p class="label muted">How James works</p>
        <h2 id="values-title" class="display h-md">Values</h2>
      </div>
      <div class="values__layout">
        <ol role="list" class="values__list">
          {
            values.map((v, i) => (
              <li>
                <span class="values__num serif">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{v.title}</h3>
                  <p class="muted">{v.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <Image
          class="values__image"
          src={chiselDetail}
          alt="Close-up of a chisel cutting into a piece of timber"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1100px) 40vw, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="section" id="areas" aria-labelledby="areas-title">
    <div class="container">
      <div class="section-head">
        <p class="label muted">Areas covered</p>
        <div>
          <h2 id="areas-title" class="display h-md">Across London</h2>
          <p class="areas__intro muted">
            Most work is in the boroughs below. If you’re just outside them, get in touch anyway.
          </p>
        </div>
      </div>
      <div class="areas">
        {
          Object.entries(boroughs).map(([region, list]) => (
            <div class="areas__group">
              <h3 class="label">{region}</h3>
              <ul role="list">
                {list.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCta />
</Base>

<style>
  .bio {
    display: grid;
    gap: 40px;
    padding-bottom: var(--section);
  }

  .bio__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .bio__text {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 18px;
    max-width: 56ch;
  }

  .bio__title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    font-stretch: 115%;
    text-transform: uppercase;
    line-height: 1;
  }

  .bio__text p:not(.label) {
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .bio {
      grid-template-columns: 6fr 5fr;
      gap: clamp(40px, 6vw, 96px);
    }

    .bio__image {
      aspect-ratio: 4 / 5;
    }
  }

  .values__layout {
    display: grid;
    gap: 48px;
  }

  .values__list {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .values__list li {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 16px;
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
  }

  .values__num {
    font-size: 2.25rem;
    line-height: 1;
    color: var(--timber);
  }

  .values__list h3 {
    margin-bottom: 6px;
    font-size: 1.375rem;
    font-weight: 700;
    font-stretch: 110%;
  }

  .values__image {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  @media (min-width: 1100px) {
    .values__layout {
      grid-template-columns: 7fr 5fr;
      gap: 64px;
    }

    .values__image {
      aspect-ratio: 4 / 5;
    }
  }

  .areas__intro {
    margin-top: 16px;
    max-width: 48ch;
  }

  .areas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px 32px;
  }

  .areas__group h3 {
    padding-bottom: 12px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--ink);
  }

  .areas__group li {
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
    font-size: 1.125rem;
  }
</style>
