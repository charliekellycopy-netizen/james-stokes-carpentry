---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactCta from '../components/ContactCta.astro';
import { projects } from '../data/site';

const areas = [...new Set(projects.map((p) => p.area))];
---

<Base
  title="Projects"
  description="Recent carpentry and joinery projects across London, from Islington kitchens to a Dulwich deck."
>
  <section class="page-head">
    <div class="container page-head__grid">
      <div>
        <p class="label muted">Projects</p>
        <h1 class="display h-lg">Recent<br />work</h1>
      </div>
      <div class="page-head__intro">
        <p class="lede">A selection of jobs from across London.</p>
        <p class="label muted areas">{areas.join(' · ')}</p>
      </div>
    </div>
  </section>

  {/* PLACEHOLDER: these projects and photos are stock examples. Replace with James's own jobs and photos. */}
  <section class="container gallery-wrap" aria-label="Project gallery">
    <ul role="list" class="gallery">
      {
        projects.map((project, i) => (
          <li class="card">
            <div class="card__media">
              <Image
                src={project.image}
                alt={project.alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1100px) 33vw, (min-width: 640px) 50vw, 100vw"
              />
              <span class="card__index label">P/{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="card__meta label">
              <span>{project.area}</span>
              <span class="muted">{project.service}</span>
            </div>
            <h2 class="card__title">{project.title}</h2>
            <p class="muted">{project.summary}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <ContactCta />
</Base>

<style>
  .areas {
    margin-top: 20px;
  }

  .gallery-wrap {
    padding-bottom: var(--section);
  }

  .gallery {
    display: grid;
    gap: 56px 24px;
  }

  @media (min-width: 640px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }

    /* Stagger the middle column for a looser editorial rhythm */
    .card:nth-child(3n + 2) {
      transform: translateY(64px);
    }

    .gallery {
      padding-bottom: 64px;
    }
  }

  .card {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .card__media {
    position: relative;
    margin-bottom: 8px;
    overflow: hidden;
  }

  .card__media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .card:hover .card__media img {
    transform: scale(1.03);
  }

  .card__index {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 8px;
    background: var(--paper);
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .card__title {
    font-size: 1.5rem;
    font-weight: 700;
    font-stretch: 110%;
    line-height: 1.1;
  }
</style>
