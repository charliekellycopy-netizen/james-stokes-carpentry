---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { business, services } from '../data/site';
import { url } from '../lib/url';
import toolWall from '../assets/photos/tool-wall.jpg';
---

<Base
  title="Contact"
  description="Contact James Stokes for a carpentry or joinery quote anywhere in Greater London."
>
  <section class="page-head">
    <div class="container page-head__grid">
      <div>
        <p class="label muted">Contact</p>
        <h1 class="display h-lg">Get a<br />quote</h1>
      </div>
      <p class="page-head__intro lede">
        Tell James about the job. You’ll hear back within two working days.
      </p>
    </div>
  </section>

  <section class="container contact" aria-label="Contact details and enquiry form">
    <aside class="contact__details">
      {/* PLACEHOLDER: phone, email and hours come from src/data/site.ts. Replace before launch. */}
      <dl>
        <div>
          <dt class="label muted">Phone</dt>
          <dd><a href={business.phoneHref}>{business.phone}</a></dd>
        </div>
        <div>
          <dt class="label muted">Email</dt>
          <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
        </div>
        <div>
          <dt class="label muted">Hours</dt>
          <dd>{business.hours}</dd>
        </div>
        <div>
          <dt class="label muted">Service area</dt>
          <dd>
            {business.area}. <a href={url('about/#areas', Astro.url)}>See the boroughs covered</a>.
          </dd>
        </div>
      </dl>
      <Image
        class="contact__image"
        src={toolWall}
        alt="Woodworking hand tools hung in rows on a dark workshop wall"
        widths={[480, 800]}
        sizes="(min-width: 900px) 30vw, 100vw"
      />
    </aside>

    {/*
      FORM NOT CONNECTED YET.
      To make this form send enquiries, sign up for Formspree (https://formspree.io) or a similar service
      (Basin, Getform, Netlify Forms if you move hosts), then:
        1. Set action="https://formspree.io/f/YOUR_FORM_ID" and method="POST" on the <form> below.
        2. Delete the data-demo-form attribute and the <script> at the bottom of this file, which currently
           stops the form submitting and shows a "not connected" message instead.
      The field name attributes are already set, so the service will receive them as they are.
    */}
    <form class="form" data-demo-form novalidate>
      <div class="form__row">
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="phone">Phone <span class="muted">(optional)</span></label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" />
        </div>
      </div>
      <div class="form__row">
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="postcode">Postcode</label>
          <input id="postcode" name="postcode" type="text" autocomplete="postal-code" required />
        </div>
      </div>
      <div class="field">
        <label for="service">Type of work</label>
        <select id="service" name="service" required>
          <option value="" disabled selected>Choose one</option>
          {services.map((s) => <option value={s.name}>{s.name}</option>)}
          <option value="Something else">Something else</option>
        </select>
      </div>
      <div class="field">
        <label for="message">About the job</label>
        <textarea id="message" name="message" rows="6" required
          placeholder="What do you need, roughly what size is the space, and when would you like it done?"></textarea>
      </div>
      <fieldset class="field field--radios">
        <legend>Best way to reach you</legend>
        <label><input type="radio" name="contact_preference" value="Phone" /> Phone</label>
        <label><input type="radio" name="contact_preference" value="Email" checked /> Email</label>
      </fieldset>
      <div class="form__foot">
        <button class="button button--solid" type="submit">Send enquiry <span aria-hidden="true">→</span></button>
        <p class="form__note muted">Photos of the space help. You can send them by email after James replies.</p>
      </div>
      <p class="form__status" role="status" aria-live="polite" hidden></p>
    </form>
  </section>
</Base>

<script>
  // Demo only: stops the unconnected form from submitting. Remove once the form has a real action (see comment above the form).
  const form = document.querySelector<HTMLFormElement>('[data-demo-form]');
  const status = form?.querySelector<HTMLElement>('.form__status');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!status) return;
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    status.hidden = false;
    status.textContent =
      'This form isn’t connected yet, so nothing was sent. Please call or email instead.';
  });
</script>

<style>
  .contact {
    display: grid;
    gap: 56px;
    padding-bottom: var(--section);
  }

  .contact__details dl {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .contact__details dl div {
    display: grid;
    gap: 4px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }

  .contact__details dd {
    font-size: 1.125rem;
  }

  .contact__details dd a {
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .contact__details dd a:hover {
    color: var(--timber);
  }

  .contact__image {
    display: none;
    border-radius: var(--radius);
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin-top: 40px;
  }

  @media (min-width: 900px) {
    .contact {
      grid-template-columns: 4fr 7fr;
      gap: clamp(48px, 7vw, 120px);
    }

    .contact__image {
      display: block;
    }
  }

  .form {
    display: grid;
    gap: 24px;
  }

  .form__row {
    display: grid;
    gap: 24px;
  }

  @media (min-width: 640px) {
    .form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    display: grid;
    gap: 8px;
  }

  .field > label,
  .field legend {
    font-family: var(--label-font);
    font-size: 0.75rem;
    font-weight: var(--label-weight);
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
  }

  input[type='text'],
  input[type='email'],
  input[type='tel'],
  select,
  textarea {
    width: 100%;
    min-height: 52px;
    padding: 12px 14px;
    border: 1px solid rgb(29 26 22 / 0.35);
    border-radius: var(--radius-small);
    background: #fbf9f5;
    color: var(--ink);
    font: inherit;
    appearance: none;
  }

  select {
    background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%),
      linear-gradient(135deg, var(--ink) 50%, transparent 50%);
    background-position: calc(100% - 20px) 50%, calc(100% - 15px) 50%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    padding-right: 40px;
  }

  textarea {
    resize: vertical;
    min-height: 160px;
  }

  textarea::placeholder {
    color: #8a8176;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--timber);
    outline-offset: 0;
    border-color: var(--timber);
  }

  .field--radios {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .field--radios legend {
    width: 100%;
    margin-bottom: 8px;
  }

  .field--radios label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    cursor: pointer;
  }

  .field--radios input {
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--timber);
  }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    padding-top: 8px;
  }

  .form__foot .button {
    cursor: pointer;
    font-size: 0.875rem;
  }

  .form__note {
    max-width: 36ch;
    font-size: 0.9375rem;
  }

  .form__status {
    padding: 14px 16px;
    border-left: 3px solid var(--timber);
    border-radius: var(--radius-small);
    background: var(--stone);
  }
</style>
