---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactCta from '../components/ContactCta.astro';
import { process, projects, services, testimonials } from '../data/site';
import { url, variantOf } from '../lib/url';
import hero from '../assets/photos/workshop-sunlit.jpg';
import warmHero from '../assets/photos/kitchen-island.jpg';
import handsChisels from '../assets/photos/hands-chisels.jpg';
import handsMarking from '../assets/photos/hands-marking.jpg';

const featuredServices = services.filter((s) =>
  ['fitted-kitchens', 'wardrobes-alcoves', 'staircases', 'bespoke-joinery'].includes(s.slug),
);
const selectedProjects = projects.slice(0, 4);
const warm = variantOf(Astro.url) === 'warm';
---

<Base
  title="Home"
  description="James Stokes is a carpenter and joiner working across London: fitted kitchens, wardrobes and alcove storage, staircases, flooring and repairs."
  overlayHeader={!warm}
>
  {
    warm ? (
      <section class="whero" aria-labelledby="hero-title">
        <div class="container whero__grid">
          <div class="whero__text">
            <p class="label muted">Carpenter &amp; joiner · London</p>
            <h1 id="hero-title" class="whero__title">
              <span class="display">James Stokes</span>
              <span class="serif whero__sub">
                Kitchens, staircases and storage, <em>made by hand to fit your home.</em>
              </span>
            </h1>
            <p class="whero__intro">
              Hello, I’m James. I measure up, make and fit every job myself, so you deal with one person from the first
              visit to the final coat.
            </p>
            <div class="whero__actions">
              <a class="button button--solid" href={url('contact/', Astro.url)}>
                Get a quote <span aria-hidden="true">→</span>
              </a>
              <a class="arrow-link" href={url('projects/', Astro.url)}>
                See recent work <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
          <div class="whero__media">
            <Image
              src={warmHero}
              alt="Kitchen with full-height timber cabinets and a white island"
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 900px) 50vw, 100vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </section>
    ) : (
  <section class="hero" aria-labelledby="hero-title">
    <Image
      class="hero__image"
      src={hero}
      alt="Sunlit carpentry workshop with timber stacked along the walls"
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__shade"></div>

    <div class="container hero__inner">
      <div class="hero__meta label">
        <span>Carpenter &amp; joiner</span>
        <span>London, UK</span>
      </div>

      <h1 id="hero-title" class="hero__title">
        <span class="display h-xl">James Stokes</span>
        <span class="serif hero__sub">Carpentry and joinery, <em>made to fit.</em></span>
      </h1>

      <div class="hero__foot">
        <ul role="list" class="hero__tags label">
          <li>Kitchens</li>
          <li>Staircases</li>
          <li>Built-in storage</li>
          <li>Repairs</li>
        </ul>
        <a class="arrow-link" href={url('projects/', Astro.url)}>See recent work <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>
    )
  }

  <section class="section intro" aria-labelledby="intro-title">
    <div class="container">
      <div class="section-head">
        <p class="label muted">01 / Introduction</p>
        <h2 id="intro-title" class="lede">
          {
            warm
              ? 'Good joinery should look as if it was always part of the house. That’s the aim on every job, from a single shelf to a whole kitchen.'
              : 'One carpenter, from first visit to final coat. Kitchens, staircases, built-in storage and repairs for homes across London.'
          }
        </h2>
      </div>

      <div class="intro__grid">
        <Image
          class="intro__image"
          src={handsChisels}
          alt="Hands working timber with chisels, surrounded by shavings"
          widths={[480, 800, 1200]}
          sizes="(min-width: 900px) 40vw, 100vw"
        />
        <div class="intro__text">
          <p>
            James Stokes is a carpenter and joiner based in London. Most work is in Victorian and Edwardian houses, where
            nothing is quite square and off-the-shelf rarely fits.
          </p>
          <p>
            You deal with the same person throughout: the one who measures up is the one who builds and fits it. Quotes
            are written and fixed, and work starts when it says it will.
          </p>
          <dl class="intro__facts">
            <div>
              <dt class="label muted">Quotes</dt>
              <dd>Written and fixed</dd>
            </div>
            <div>
              <dt class="label muted">Area</dt>
              <dd>Greater London</dd>
            </div>
            <div>
              <dt class="label muted">Jobs</dt>
              <dd>Small repairs to full fit-outs</dd>
            </div>
          </dl>
          <a class="arrow-link" href={url('about/', Astro.url)}>About James <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--stone" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head">
        <p class="label muted">02 / Services</p>
        <div class="head-row">
          <h2 id="services-title" class="display h-md">What James does</h2>
          <a class="arrow-link" href={url('services/', Astro.url)}>All services <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <ul role="list" class="service-cards">
        {
          featuredServices.map((service, i) => (
            <li class="service-card">
              <a href={url(`services/#${service.slug}`, Astro.url)}>
                <div class="service-card__media">
                  <Image
                    src={service.image}
                    alt={service.alt}
                    widths={[400, 640, 900]}
                    sizes="(min-width: 1100px) 25vw, (min-width: 640px) 50vw, 100vw"
                  />
                </div>
                <p class="label muted">{String(i + 1).padStart(2, '0')}</p>
                <h3>{service.name}</h3>
                <p class="muted">{service.short}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-head">
        <p class="label muted">03 / Selected work</p>
        <div class="head-row">
          <h2 id="projects-title" class="display h-md">Recent projects</h2>
          <a class="arrow-link" href={url('projects/', Astro.url)}>All projects <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <ul role="list" class="project-grid">
        {
          selectedProjects.map((project, i) => (
            <li class={`project project--${i + 1}`}>
              <div class="project__media">
                <Image
                  src={project.image}
                  alt={project.alt}
                  widths={[480, 800, 1200, 1600]}
                  sizes="(min-width: 900px) 60vw, 100vw"
                />
              </div>
              <div class="project__meta label">
                <span>{project.area}</span>
                <span class="muted">{project.service}</span>
              </div>
              <h3 class="project__title">{project.title}</h3>
              <p class="muted">{project.summary}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--dark process" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head">
        <p class="label process__label">04 / Process</p>
        <h2 id="process-title" class="display h-md">How a job runs</h2>
      </div>

      <div class="process__layout">
        <Image
          class="process__image"
          src={handsMarking}
          alt="A pencil marking a cut line on a timber board"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1100px) 33vw, 100vw"
        />
        <ol role="list" class="process__steps">
          {
            process.map((item, i) => (
              <li>
                <span class="process__num serif">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{item.step}</h3>
                  <p>{item.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  {/* SAMPLE TESTIMONIALS: the quotes come from src/data/site.ts and are invented placeholders, not real reviews. */}
  <section class="section section--stone" aria-labelledby="testimonials-title">
    <div class="container">
      <div class="section-head">
        <p class="label muted">05 / Clients</p>
        <h2 id="testimonials-title" class="display h-md">What clients say</h2>
      </div>

      <ul role="list" class="quotes">
        {
          testimonials.map((t) => (
            <li>
              <figure>
                <blockquote class="serif">“{t.quote}”</blockquote>
                <figcaption class="label muted">
                  {t.name}, {t.area}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactCta />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: max(640px, 100svh);
    color: var(--on-dark);
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(20 16 12 / 0.55) 0%, rgb(20 16 12 / 0) 28%),
      linear-gradient(0deg, rgb(20 16 12 / 0.78) 0%, rgb(20 16 12 / 0.15) 60%);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 32px;
    padding-top: 128px;
    padding-bottom: clamp(24px, 4vw, 48px);
  }

  .hero__meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: auto;
    opacity: 0.85;
  }

  .hero__title {
    display: grid;
    gap: clamp(12px, 2vw, 24px);
    font-weight: inherit;
  }

  .hero__title .display {
    display: block;
    font-size: clamp(3.25rem, 17vw, 12.5rem);
  }

  .hero__sub {
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    line-height: 1.05;
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--line-dark);
  }

  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero__tags li {
    padding: 6px 10px;
    border-radius: var(--radius-button);
    background: rgb(244 240 233 / 0.92);
    color: var(--ink);
  }

  /* Warm hero: text on cream beside a rounded photo */
  .whero {
    padding-top: 88px;
  }

  .whero__grid {
    display: grid;
    gap: 40px;
    padding-block: clamp(40px, 6vw, 96px) clamp(56px, 8vw, 120px);
  }

  .whero__text {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 24px;
  }

  .whero__title {
    display: grid;
    gap: 16px;
    font-weight: inherit;
  }

  .whero__title .display {
    font-size: clamp(3.5rem, 9vw, 8.5rem);
  }

  .whero__sub {
    max-width: 18ch;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    line-height: 1.08;
    color: var(--timber);
  }

  .whero__intro {
    max-width: 44ch;
    font-size: 1.125rem;
    color: var(--ink-soft);
  }

  .whero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }

  .whero__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }

  @media (min-width: 900px) {
    .whero__grid {
      grid-template-columns: 6fr 6fr;
      gap: clamp(40px, 5vw, 80px);
      align-items: center;
    }

    .whero__media img {
      aspect-ratio: 4 / 5;
      max-height: calc(100svh - 160px);
    }
  }

  /* Shared heading row */
  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px 32px;
  }

  /* Intro */
  .intro__grid {
    display: grid;
    gap: 40px;
  }

  .intro__image {
    width: 100%;
    border-radius: var(--radius);
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .intro__text {
    display: grid;
    align-content: start;
    gap: 20px;
    max-width: 52ch;
  }

  .intro__facts {
    display: grid;
    margin-block: 12px;
    border-top: 1px solid var(--line);
  }

  .intro__facts div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
  }

  .intro__facts dt {
    padding-top: 4px;
  }

  @media (min-width: 900px) {
    .intro__grid {
      grid-template-columns: 3fr 4fr 5fr;
      gap: 32px;
    }

    .intro__image {
      grid-column: 2;
    }

    .intro__text {
      grid-column: 3;
      padding-left: clamp(0px, 3vw, 48px);
    }
  }

  /* Service cards */
  .service-cards {
    display: grid;
    gap: 40px 24px;
  }

  @media (min-width: 640px) {
    .service-cards {
      grid-template-columns: repeat(2, 1fr);
    }

    .service-card__media img {
      aspect-ratio: 4 / 5;
    }
  }

  @media (min-width: 1100px) {
    .service-cards {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .service-card a {
    display: grid;
    gap: 10px;
    text-decoration: none;
  }

  .service-card__media {
    margin-bottom: 8px;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .service-card__media img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .service-card a:hover img {
    transform: scale(1.04);
  }

  .service-card h3 {
    font-size: calc(1.375rem * var(--title-scale));
    font-family: var(--title-font);
    font-weight: var(--title-weight);
    font-stretch: var(--title-stretch);
    line-height: 1.15;
  }

  /* Projects */
  .project-grid {
    display: grid;
    gap: 56px 24px;
  }

  .project {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .project__media {
    margin-bottom: 8px;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .project__media img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .project__meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .project__title {
    font-size: calc(clamp(1.5rem, 2.4vw, 2rem) * var(--title-scale));
    font-family: var(--title-font);
    font-weight: var(--title-weight);
    font-stretch: var(--title-stretch);
    line-height: 1.1;
  }

  @media (min-width: 900px) {
    .project-grid {
      grid-template-columns: repeat(12, 1fr);
    }

    .project--1 {
      grid-column: 1 / span 7;
    }

    .project--2 {
      grid-column: 9 / span 4;
    }

    .project--2 .project__media img {
      aspect-ratio: 4 / 5;
    }

    .project--3 {
      grid-column: 1 / span 5;
    }

    .project--3 .project__media img {
      aspect-ratio: 4 / 5;
    }

    .project--4 {
      grid-column: 7 / span 6;
      margin-top: clamp(0px, 8vw, 120px);
    }
  }

  /* Process */
  .process .section-head {
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .process__label {
    color: var(--on-dark-soft);
  }

  .process__layout {
    display: grid;
    gap: 48px;
  }

  .process__image {
    width: 100%;
    border-radius: var(--radius);
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .process__steps {
    display: grid;
    border-top: 1px solid var(--line-dark);
  }

  .process__steps li {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 16px;
    padding-block: 24px;
    border-bottom: 1px solid var(--line-dark);
  }

  .process__num {
    font-size: 2.25rem;
    line-height: 1;
    color: var(--timber-light);
  }

  .process__steps h3 {
    margin-bottom: 6px;
    font-size: calc(1.375rem * var(--title-scale));
    font-family: var(--title-font);
    font-weight: var(--title-weight);
    font-stretch: var(--title-stretch);
  }

  .process__steps p {
    color: var(--on-dark-soft);
    max-width: 46ch;
  }

  @media (min-width: 1100px) {
    .process__layout {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: start;
    }

    .process__image {
      aspect-ratio: 4 / 5;
      position: sticky;
      top: 32px;
    }

    .process__steps li {
      grid-template-columns: 96px 1fr;
      padding-block: 32px;
    }

    .process__num {
      font-size: 3rem;
    }
  }

  /* Testimonials */
  .quotes {
    display: grid;
    gap: 40px 32px;
  }

  @media (min-width: 900px) {
    .quotes {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .quotes figure {
    display: grid;
    gap: 24px;
    height: 100%;
    padding-top: 24px;
    border-top: 1px solid var(--ink);
  }

  .quotes blockquote {
    font-size: clamp(1.5rem, 2.2vw, 1.875rem);
    line-height: 1.2;
    text-wrap: pretty;
  }
</style>
