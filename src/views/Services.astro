---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactCta from '../components/ContactCta.astro';
import { services } from '../data/site';
---

<Base
  title="Services"
  description="Carpentry and joinery services in London: bespoke joinery, fitted kitchens, wardrobes and alcove storage, staircases, doors, sash windows, decking, flooring and repairs."
>
  <section class="page-head">
    <div class="container page-head__grid">
      <div>
        <p class="label muted">Services</p>
        <h1 class="display h-lg">Built to<br />fit the room</h1>
      </div>
      <p class="page-head__intro lede">
        Nine kinds of work, from a sticking door to a full kitchen. Every job gets a visit and a fixed written quote.
      </p>
    </div>
  </section>

  <nav class="container service-index" aria-label="Services on this page">
    <ol role="list">
      {
        services.map((s, i) => (
          <li>
            <a href={`#${s.slug}`}>
              <span class="label muted">{String(i + 1).padStart(2, '0')}</span>
              {s.name}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="container services">
    {
      services.map((service, i) => (
        <article class:list={['service', { 'service--flip': i % 2 === 1 }]} id={service.slug}>
          <div class="service__media">
            <Image
              src={service.image}
              alt={service.alt}
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 900px) 50vw, 100vw"
            />
          </div>
          <div class="service__body">
            <p class="label muted">{String(i + 1).padStart(2, '0')} / {String(services.length).padStart(2, '0')}</p>
            <h2 class="service__title">{service.name}</h2>
            <p class="service__desc">{service.description}</p>
            <h3 class="label muted">Typical jobs</h3>
            <ul role="list" class="service__jobs">
              {service.jobs.map((job) => <li>{job}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </div>

  <ContactCta />
</Base>

<style>
  .service-index {
    padding-bottom: clamp(48px, 6vw, 96px);
  }

  .service-index ol {
    display: grid;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 640px) {
    .service-index ol {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 32px;
    }
  }

  @media (min-width: 1100px) {
    .service-index ol {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-index a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
    text-decoration: none;
  }

  .service-index a:hover {
    color: var(--timber);
  }

  .services {
    display: grid;
    gap: clamp(64px, 9vw, 128px);
    padding-bottom: var(--section);
  }

  .service {
    display: grid;
    gap: 28px;
    scroll-margin-top: 32px;
  }

  .service__media {
    overflow: hidden;
    border-radius: var(--radius);
  }

  .service__media img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .service__body {
    display: grid;
    align-content: start;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .service__title {
    font-size: calc(clamp(2rem, 3.6vw, 3rem) * var(--display-scale));
    font-family: var(--display-font);
    font-weight: var(--display-weight);
    font-stretch: var(--display-stretch);
    line-height: 1;
    letter-spacing: -0.015em;
    text-transform: var(--display-transform);
  }

  .service__desc {
    max-width: 46ch;
    font-size: 1.125rem;
  }

  .service__body h3 {
    margin-top: 8px;
  }

  .service__jobs {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .service__jobs li {
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .service {
      grid-template-columns: 7fr 5fr;
      gap: clamp(32px, 5vw, 80px);
      align-items: start;
    }

    .service--flip {
      grid-template-columns: 5fr 7fr;
    }

    .service--flip .service__media {
      order: 2;
    }
  }
</style>
